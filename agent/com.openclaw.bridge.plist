<?xml version="1.0" encoding="UTF-8"?>
<!-- macOS LaunchAgent：放到 ~/Library/LaunchAgents/ 下后 launchctl load -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.openclaw.bridge</string>
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/openclaw-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/node</string>
    <string>dist/index.js</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/openclaw-bridge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/openclaw-bridge.err.log</string>
</dict>
</plist>
