# Bridge Agent 配置 — 复制为 .env 后修改

# 监听端口与地址
PORT=8787
HOST=0.0.0.0

# 访问 Token（PWA 端需要在设置页填入相同的值）
# 留空 please-change-me 时启动会有警告，运行 install.sh 时会自动生成。
BRIDGE_TOKEN=please-change-me

# 允许跨域的来源；用逗号分隔，留 * 允许任意。
# 部署到自有域名时建议设为具体域名，例如 ALLOWED_ORIGINS=https://claw.example.com
ALLOWED_ORIGINS=*

# OpenClaw 可执行文件路径与数据目录（如果不在 PATH / ~/.openclaw）
# OPENCLAW_BIN=/bin/openclaw
# OPENCLAW_HOME=/root/.openclaw
# OpenClaw 网关默认监听 127.0.0.1:18789（v2026.4+ 实测值；不同部署可能为 18791）
# OPENCLAW_GATEWAY_PORT=18789
# 由 systemd 接管时的 unit 名（默认 openclaw-gateway）
# OPENCLAW_SYSTEMD_UNIT=openclaw-gateway
# 默认 agent 工作区名（probe 看到的是 main）
# OPENCLAW_DEFAULT_AGENT=main

# Web Push（可选）— 运行 `npm run vapid` 生成
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:admin@localhost

# 阈值（百分比），超过将触发 Web Push 通知
PUSH_CPU_THRESHOLD=90
PUSH_MEM_THRESHOLD=90
